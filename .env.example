APP_NAME="ALMARA Billing WiFi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://billing-smart-wifi.test
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=billing_smart_wifi
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Dev lokal: sync (langsung jalan). Produksi: redis + Supervisor `php artisan queue:work`
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- ALMARA ---
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_EMAIL=superadmin@example.com
# Kosongkan agar password acak dibuat & ditampilkan sekali saat seeding
SUPERADMIN_PASSWORD=

# PWA (service worker): kosongkan = otomatis aktif hanya di APP_ENV=production
ALMARA_PWA=

# Domain platform untuk subdomain tenant (opsional), mis. almara-billing.id
ALMARA_PLATFORM_DOMAIN=

# WhatsApp Gateway: log (hanya dicatat) | http (adapter HTTP generik ke gateway Anda)
WHATSAPP_DRIVER=log
WHATSAPP_HTTP_URL=
WHATSAPP_HTTP_TOKEN=
WHATSAPP_HTTP_NUMBER_FIELD=number
WHATSAPP_HTTP_MESSAGE_FIELD=message
WHATSAPP_RATE_PER_MINUTE=20

# Payment Gateway (webhook HMAC-SHA256). Endpoint: POST /webhooks/payment/{provider}
PAYMENT_GATEWAY_PROVIDER=generic
PAYMENT_GATEWAY_WEBHOOK_SECRET=
PAYMENT_GATEWAY_SIGNATURE_HEADER=X-Signature
